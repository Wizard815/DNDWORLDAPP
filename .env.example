# Copy to .env for local development. In Docker these are set in compose.yaml.

# Port the server listens on (API + built web client, one process).
PORT=8080

# Where the SQLite database and uploaded assets live. This is the volume mount.
DATA_DIR=./data

# Public base URL. Used for cookie security and share links.
BASE_URL=http://localhost:8080

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-before-you-expose-this-to-anything

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
